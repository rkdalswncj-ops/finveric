# 로컬은 키 없이 Anvil 전용 테스트 계정 6개를 사용한다.
NETWORK=local
RPC_URL=http://127.0.0.1:8545
PORT=3001
# 웹을 API와 다른 도메인에 둘 때만 지정한다. 쉼표로 여러 출처를 지정한다.
# 같은 도메인(Vercel 배포)과 로컬 개발 포트 5173은 따로 지정하지 않아도 된다.
WEB_ORIGIN=http://localhost:5173
# 외부 배포에서는 반드시 임의의 긴 값을 지정한다. 기관 화면에 입력한다.
# DEMO_TOKEN=
# Sepolia는 npm run sepolia:prepare로 .env.sepolia를 생성한다.

# Vercel 배포에서만 쓴다. 판매 기록 공유 저장소와 잠금이다.
# Vercel Marketplace의 Upstash Redis를 연결하면 자동으로 들어간다. 둘 중 한 쌍을 쓴다.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# 배포 순서와 전체 변수: docs/deploy.md
